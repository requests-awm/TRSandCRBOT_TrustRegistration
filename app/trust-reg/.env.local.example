# ---------------------------------------------------------------------------
# Data source for the UI
#   mock  -> in-browser placeholder data, no backend needed (current default)
#   http  -> the /api routes, backed by Supabase (switch once DB + API are live)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DATA_SOURCE="mock"

# ---------------------------------------------------------------------------
# Auth mode for the API routes
#   supabase -> real session cookie + trust_reg.profiles lookup (default)
#   dev      -> PLACEHOLDER: caller picks a role with the x-dev-role header. Never in production.
# ---------------------------------------------------------------------------
AUTH_MODE="supabase"
NEXT_PUBLIC_AUTH_MODE="supabase"
DEV_DEFAULT_ROLE="administrator"

# ---------------------------------------------------------------------------
# Database (Prisma Migrate only; runtime uses supabase-js)
# Local:  supabase start -> postgresql://postgres:postgres@localhost:54322/postgres
# Shared: ask Colin for the trust_reg connection string
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Supabase project (local or shared)
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"

# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# Insightly join (public.insightly_contacts). Leave unset to reuse the values above.
# INSIGHTLY_SUPABASE_URL=""
# INSIGHTLY_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Evidence storage (private Supabase Storage bucket, see supabase/sql/003_storage.sql)
# ---------------------------------------------------------------------------
EVIDENCE_BUCKET="trust-registration-evidence"
MAX_UPLOAD_BYTES="26214400"

# ---------------------------------------------------------------------------
# Notifications: console (logs only) | resend | sendgrid
# ---------------------------------------------------------------------------
NOTIFICATION_PROVIDER="console"
NOTIFICATION_FROM_EMAIL="trust-registration@ascotwm.com"
# RESEND_API_KEY=""
# SENDGRID_API_KEY=""
# Used in email links back to the case page.
APP_BASE_URL="http://localhost:3000"
# Where WM notifications go if the requesting user's email cannot be resolved from auth.users.
# WM_FALLBACK_EMAIL=""
# Where deadline reminders go if the requirement has no assigned AEP owner.
# AEP_TEAM_EMAIL=""

# ---------------------------------------------------------------------------
# Scheduled job (/api/jobs/daily): overdue recompute + deadline reminders
# ---------------------------------------------------------------------------
# Random secret; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>". Unset = job disabled.
# CRON_SECRET=""
DEADLINE_WARNING_DAYS="14"
# Actor recorded on system-generated events. Must exist in trust_reg.profiles once the DB is live.
# SYSTEM_USER_ID=""
