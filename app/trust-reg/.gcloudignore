# Upload only what the Dockerfile needs. Cloud Build context = app/trust-reg.
.gcloudignore
.git
node_modules
.next
out
coverage
*.tsbuildinfo
npm-debug.log*

# Never upload secrets or local data
.env
.env.*
!.env.example
.local-stack
supabase/.temp
.vercel
.claude

# Not needed in the image
*.md
!README.md
