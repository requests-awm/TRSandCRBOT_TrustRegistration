# Runtime + build configuration for docker compose. Copy to .env.docker and fill in. Never commit .env.docker.

# ---- Build arguments (compiled into the browser bundle; change -> rebuild image) ---------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
NEXT_PUBLIC_DATA_SOURCE=http
NEXT_PUBLIC_AUTH_MODE=supabase

# ---- Runtime ---------------------------------------------------------------------------------
AUTH_MODE=supabase
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Prisma migrations only (migrator service). Use the direct connection string, not the pooler.
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.YOUR-PROJECT.supabase.co:5432/postgres

EVIDENCE_BUCKET=trust-registration-evidence
MAX_UPLOAD_BYTES=26214400

NOTIFICATION_PROVIDER=console
NOTIFICATION_FROM_EMAIL=trust-registration@ascotwm.com
# RESEND_API_KEY=
# SENDGRID_API_KEY=
APP_BASE_URL=http://localhost:3000
# WM_FALLBACK_EMAIL=
# AEP_TEAM_EMAIL=

# Random secret for /api/jobs/daily. Unset = job disabled.
CRON_SECRET=REPLACE_ME
DEADLINE_WARNING_DAYS=14
# SYSTEM_USER_ID=

# ---- Compose-only ----------------------------------------------------------------------------
APP_PORT=3000
IMAGE_TAG=local
# UTC time for the optional in-stack cron service (profile "jobs")
DAILY_JOB_UTC=06:00
