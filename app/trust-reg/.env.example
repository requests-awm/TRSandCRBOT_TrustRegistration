# =====================================================================================================
# Trust Registration Monitor (TRS / CRBOT) — the ONE environment template
#
#   cp .env.example .env.local
#
# .env.local is read by `next dev`, `next build`, the integration test AND docker compose
# (the docker:* npm scripts pass --env-file .env.local). It is git-ignored; never commit it.
#
# Pick a preset, then fill in the values marked REPLACE_ME.
#
#   A. Placeholder demo (default)  DATA_SOURCE=mock  AUTH=dev       no database needed
#   B. Local real database         DATA_SOURCE=http  AUTH=dev       `npm run stack:app`, use values it prints
#   C. Shared AWM Supabase         DATA_SOURCE=http  AUTH=supabase  keys from Colin, real users in trust_reg.profiles
#   D. Docker image                same as C; NEXT_PUBLIC_* become build args, the rest is runtime env
# =====================================================================================================


# ---- 1. Mode switches ---------------------------------------------------------------------------
# mock -> in-browser placeholder data, role switcher in the sidebar.  http -> the /api routes + Supabase.
NEXT_PUBLIC_DATA_SOURCE="mock"

# supabase -> session cookie + trust_reg.profiles lookup.  dev -> role from the x-dev-role header
# (refused in production builds). Both variables must agree.
AUTH_MODE="dev"
NEXT_PUBLIC_AUTH_MODE="dev"
DEV_DEFAULT_ROLE="administrator"


# ---- 2. Supabase project (presets B, C, D) ------------------------------------------------------
# B: http://127.0.0.1:54321 and the two keys printed by `npm run stack`.
# C: Project URL, anon key and service role key from the Supabase dashboard (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"
# Server-only. Never expose to the browser, never commit, never put in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# Prisma migrations only (`npm run db:migrate`, docker:migrate). The app itself never uses this.
# Use the DIRECT connection string (port 5432), not the pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"


# ---- 3. Evidence storage -------------------------------------------------------------------------
# Private bucket created by supabase/sql/003_storage.sql. 26214400 = 25 MiB, matches the bucket limit.
EVIDENCE_BUCKET="trust-registration-evidence"
MAX_UPLOAD_BYTES="26214400"


# ---- 4. Notifications ----------------------------------------------------------------------------
# console -> log + notifications table only.  resend | sendgrid -> real email (set the matching key).
NOTIFICATION_PROVIDER="console"
NOTIFICATION_FROM_EMAIL="trust-registration@ascotwm.com"
# RESEND_API_KEY=""
# SENDGRID_API_KEY=""
# Absolute URL used in email links back to a case.
APP_BASE_URL="http://localhost:3000"
# Used when a WM requester's email cannot be resolved from auth.users.
# WM_FALLBACK_EMAIL=""
# Receives deadline reminders for unassigned requirements.
# AEP_TEAM_EMAIL=""


# ---- 5. Scheduler (/api/jobs/daily) --------------------------------------------------------------
# Random secret sent as `Authorization: Bearer <CRON_SECRET>`. Unset = job disabled (503).
# CRON_SECRET=""
DEADLINE_WARNING_DAYS="14"
# Profile id recorded as performed_by on job-generated events. Defaults to the nil UUID.
# SYSTEM_USER_ID=""


# ---- 6. Insightly join (optional) ------------------------------------------------------------------
# Read-only lookup in public.insightly_contacts. Leave unset to reuse the Supabase values above.
# INSIGHTLY_SUPABASE_URL=""
# INSIGHTLY_SUPABASE_ANON_KEY=""


# ---- 7. Docker compose only (preset D) --------------------------------------------------------------
APP_PORT="3000"
IMAGE_TAG="local"
# UTC time for the optional in-stack `cron` service (profile "jobs").
DAILY_JOB_UTC="06:00"


# ---- 8. Local stack ports (preset B, rarely changed) -----------------------------------------------
# STACK_PG_PORT="54322"
# STACK_PGRST_PORT="54323"
# STACK_API_PORT="54321"
# STACK_APP_PORT="3000"


# ---- 9. Process tuning (pending business answers; defaults are sensible) ---------------------------
# Days without activity before an open case is shown as "stalled" and its owner is nudged weekly.
NEXT_PUBLIC_STALE_AFTER_DAYS="14"
STALE_AFTER_DAYS="14"
# When WM is emailed: milestones (gate opened, hand-back, stuck) or all (every registration status change).
WM_NOTIFY_ON="milestones"
